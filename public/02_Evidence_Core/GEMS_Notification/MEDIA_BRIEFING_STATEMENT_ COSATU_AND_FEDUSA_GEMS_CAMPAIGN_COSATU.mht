.frontier-widget ul ul, .frontier-widget ol ol { margin: 4px 0px; padding-left: 15px; }

.frontier-widget li { list-style: none; margin: 0px; padding: 5px 0px; border-bottom: 1px solid rgb(224, 224, 224); }

.frontier-widget li:last-child { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

.widget_search label .screen-reader-text { display: none; }

.widget_search label .search-field { background-color: rgb(238, 238, 238); margin: 4px 4px 4px 0px; padding: 4px; min-width: 55%; border: 1px solid rgb(85, 85, 85); box-shadow: rgb(51, 51, 51) 0px 0px 2px inset; }

.widget_search .search-submit { background-color: rgb(42, 90, 142); border: 1px solid rgb(51, 51, 51); border-radius: 3px; box-shadow: rgb(51, 51, 51) 0px 0px 0px; color: rgb(255, 255, 255); cursor: pointer; margin: 2px 0px; padding: 4px 8px; }

.widget_tag_cloud { line-height: 24px; }

.widget_calendar table { width: 100%; margin: 0px auto; text-align: center; line-height: 1.2; }

.widget_calendar caption { background-color: rgb(42, 90, 142); padding: 8px 0px; color: rgb(255, 255, 255); }

.widget_calendar th { background-color: rgb(224, 224, 224); padding: 8px; }

.widget_calendar td { background-color: rgb(255, 255, 255); padding: 8px; }

#slider { background-color: rgb(255, 255, 255); border: 1px solid rgb(85, 85, 85); box-shadow: rgb(51, 51, 51) 0px 0px 2px; display: block; overflow: hidden; }

.slider-main { margin: 5px; }

.slider-content { margin-bottom: 10px; }

#basic-slider { max-width: 100% !important; }

.bjqs, .bjqs-slide { margin: 0px; padding: 0px; list-style: none; display: none; }

.bjqs { position: relative; }

.bjqs-slide { position: absolute; }

.bjqs-slide a { display: block; }

.bjqs-slide img { display: block; margin: auto; }

.bjqs-controls { list-style: none; margin: 0px; padding: 0px; z-index: 9999; }

.bjqs-controls a { position: absolute; transition: left 0.3s ease-in-out, right; }

.bjqs-prev a { left: -50px; }

.bjqs-next a { right: -50px; }

.slider-prev { background-image: url("images/slider-prev.png"); }

.slider-next { background-image: url("images/slider-next.png"); }

.slider-prev, .slider-next { display: block; height: 32px; width: 38px; }

#basic-slider:hover li.bjqs-next a { right: 10px; }

#basic-slider:hover li.bjqs-prev a { left: 10px; }

.slider-element { display: none; }

.bjqs-heading, .bjqs-descript { background-color: rgba(0, 0, 0, 0.65); color: rgb(238, 238, 238); padding: 8px; width: 100%; }

.bjqs-heading { position: absolute; top: 0px; font-size: 16px; }

.bjqs-descript { position: absolute; bottom: 0px; }

