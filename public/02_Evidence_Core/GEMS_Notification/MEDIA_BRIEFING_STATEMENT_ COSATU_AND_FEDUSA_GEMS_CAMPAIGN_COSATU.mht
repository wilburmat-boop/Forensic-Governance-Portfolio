#bbpress-forums .bbp-topic-permalink { font-size: 0.875rem; }

#bbpress-forums .avatar { min-width: 20px; min-height: 20px; }

#bbpress-forums .bbp-reply-content { padding: 10px 0px 0px; }

.bbp-pagination-links > * { background-color: rgb(34, 34, 34); color: rgb(255, 255, 255); padding: 2px 10px !important; border: 1px solid rgb(0, 0, 0) !important; }

.bbp-pagination-links .page-numbers.current { background-color: rgb(85, 85, 85); }

.bbp-pagination-links > a:hover { background-color: rgb(224, 224, 224); color: rgb(0, 0, 0); font-weight: bold; }

@media print {
  #nav-top, #header, #nav-main, #below-menu, #slider, #sidebar-right, #sidebar-left, #footer, #bottom-bar, #comment-area, #widgets-wrap-before-content, #widgets-wrap-after-content, #widgets-wrap-before-post, #widgets-wrap-after-post, #widgets-wrap-before-post-content, #widgets-wrap-after-post-content, .entry-footer, .blog-nav, .post-nav { display: none; }
  #main, #content { padding: 0px; }
  #content { display: block; float: none; width: auto; }
  .blog-view, .single-view { border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; }
  .blog-view, .blog-view.sticky { border-top: 1px dashed rgb(85, 85, 85); }
  #site-title a { color: rgb(0, 0, 0); }
  #site-description { color: rgb(51, 51, 51); }
  .entry-byline a, .genericon { color: rgb(51, 51, 51); }
}
