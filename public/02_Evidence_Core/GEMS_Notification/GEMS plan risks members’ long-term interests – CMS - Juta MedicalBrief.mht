@charset "utf-8";

#bela-container { width: 100%; clear: both; font-size: 14px; line-height: 2; margin-top: 5px; overflow: hidden; padding-top: 5px; position: relative; }

#bela-container ul { margin: 0px; padding: 0px; list-style: inside none disc; }

#bela-container ul li { list-style-image: none; list-style-type: none; margin: 0px auto; padding: 1px 8px; text-align: left; }

#bela-container ul li.active { background: none 0px 0px repeat scroll rgb(255, 246, 191); }

#bela-container ul li:hover, div.bela-next-page:hover, div.bela-pre-page:hover { background: none 0px 0px repeat scroll rgb(243, 243, 243); }

#bela-navi-menu { border-bottom: 1px solid rgb(204, 204, 204); height: 24px; }

#bela-navi-menu li { border-image: none 100% / 1 / 0 stretch; border-style: solid solid none; border-width: 1px 1px medium; display: inline; margin-bottom: 0px; padding: 2px 10px !important; }

#bela-navi-menu li:hover { }

.bela-loading { position: absolute; top: 0px; right: 0px; }

.bela-category, .bela-chrono-year, .bela-chrono-month, .bela-tag, .bela-post-list { border-left: 1px solid rgb(204, 204, 204); float: left; font-weight: bold; }

.bela-category { width: 40%; }

.bela-chrono-year, .bela-chrono-month { width: 20%; }

.tag-entry { display: inline-block; font-weight: normal; }

.bela-post-list { width: 59%; }

ul.bela-orderby-tag { width: 80%; }

.bela-next-page, .bela-pre-page { text-align: center; }
