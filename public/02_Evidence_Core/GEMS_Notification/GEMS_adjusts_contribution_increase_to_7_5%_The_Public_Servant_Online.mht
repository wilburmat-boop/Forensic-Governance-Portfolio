@charset "utf-8";

.mx_image_background { background-color: rgb(242, 242, 242); }

.td-visibility-hidden { visibility: hidden; }

.clearfix { }

.clearfix::before, .clearfix::after { display: table; content: ""; line-height: 0; }

.clearfix::after { clear: both; }

body .td-header-row .td-header-sp-rec { min-height: 0px; }

.td-header-main-menu.td-affix { transform: translate3d(0px, 0px, 0px); width: 1021px; margin-right: auto; margin-left: auto; left: 0px; right: 0px; top: 0px; z-index: 9999; position: fixed !important; }

@media (min-width: 768px) and (max-width: 1023px) {
  .td-header-main-menu.td-affix { width: 756px; }
}

@media (max-width: 767px) {
  .td-header-main-menu.td-affix { width: auto; }
}

.admin-bar .td-header-main-menu.td-affix { top: 32px; }

@media (min-width: 527px) and (max-width: 782px) {
  .admin-bar .td-header-main-menu.td-affix { top: 46px; }
}

